{
  "name": "patchy",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Patch layers: patch docs that change another document without writing on it, a panel to make and land them, and a vector layer editor built on them.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@automerge/automerge-repo": "2.6.0-subduction.49",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.4",
    "@inkandswitch/patchwork-elements": "^6.0.2",
    "@inkandswitch/patchwork-plugins": "^1.2.5",
    "@inkandswitch/patchwork-providers": "^0.5.4",
    "@inkandswitch/patchwork-providers-solid": "^0.2.8",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@automerge/automerge-subduction": "0.20.1",
    "@inkandswitch/patchwork-bootloader": "^0.7.2",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^3.2.6"
  }
}
