{
  "name": "@tiny-patchwork/fea",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "Finite element analysis with CalculiX: link a part from any CAD tool or scene, say how it is held and loaded, run it on a daemon anywhere, and see stress and deflection on the part, in the study or in a scene.",
  "bin": {
    "fead": "./daemon/fead.mjs"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "daemon": "node daemon/fead.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@automerge/automerge": "3.3.0-fragments.2",
    "@automerge/automerge-repo": "2.6.0-subduction.43",
    "@automerge/automerge-repo-storage-nodefs": "2.6.0-subduction.43",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "happy-dom": "^15.11.7",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
