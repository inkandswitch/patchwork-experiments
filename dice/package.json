{
  "name": "@tiny-patchwork/dice",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "Dice as documents: a die's shape and what each face shows are data, edited in a 2D panel, built at real size into any 3D scene, and rolled, read, turned by hand and thrown together there.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "@inkandswitch/patchwork-plugins": "^0.0.11",
    "happy-dom": "^15.11.7",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
