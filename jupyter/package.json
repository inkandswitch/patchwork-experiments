{
  "name": "@patchwork/jupyter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jupyter notebooks on Automerge, twice: the real JupyterLab UI (lab/) and a Patchwork-native one (native/), both running Pyodide offline",
  "main": "dist/index.js",
  "scripts": {
    "setup": "uv venv --allow-existing .venv && uv pip install --python .venv -r lab/requirements.txt && pnpm --dir lab/extension install && pnpm install",
    "build:extension": "PATH=\"$PWD/.venv/bin:$PATH\" pnpm --dir lab/extension build",
    "build:lite": ".venv/bin/python lab/scripts/build_lite.py",
    "build:lab": "pnpm build:extension && pnpm build:lite",
    "build:native": "python3 -I native/scripts/build_kernel.py",
    "build:pyfs": "vite build --config shared/pyfs/vite.config.ts",
    "build:tool": "rm -rf dist/*.js dist/assets && vite build",
    "build": "pnpm build:lab && pnpm build:native && pnpm build:pyfs && pnpm build:tool",
    "typecheck": "tsc -p . && pnpm --dir lab/extension exec tsc --noEmit",
    "test": "vitest run && pnpm --dir lab/extension test",
    "push": "pnpm build && pushwork sync"
  },
  "devDependencies": {
    "@automerge/automerge": "3.5.0",
    "@automerge/automerge-repo": "2.6.0-subduction.49",
    "@automerge/automerge-repo-storage-indexeddb": "2.6.0-subduction.49",
    "@automerge/automerge-subduction": "0.20.1",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@inkandswitch/patchwork-bootloader": "^0.2.7",
    "@inkandswitch/patchwork-providers": "^0.5.5",
    "@jupyterlab/nbformat": "^4.6.5",
    "@jupyterlab/rendermime": "~4.6.6",
    "@jupyterlab/rendermime-interfaces": "~3.14.6",
    "@jupyterlab/services": "~7.6.6",
    "@jupyterlab/ui-components": "4.6.6",
    "@jupyterlite/pyodide-kernel": "0.8.6",
    "@jupyterlite/services": "0.8.7",
    "@lezer/highlight": "^1.2.5",
    "@lumino/widgets": "^2.10.0",
    "marked": "^16.4.2",
    "playwright-core": "^1.56.0",
    "solid-js": "^1.9.19",
    "typescript": "~5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "3.2.4"
  }
}
