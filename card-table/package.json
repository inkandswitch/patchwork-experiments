{
  "name": "@tiny-patchwork/card-table",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "A secure deck for tables: a mental-poker shuffle nobody can see through, and card reveals that follow what the table shows. Plugs into a scene as its secrets provider.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "bench": "node scripts/bench.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "@inkandswitch/patchwork-plugins": "^0.0.11",
    "happy-dom": "^15.11.7",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
