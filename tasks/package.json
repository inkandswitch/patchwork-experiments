{
  "name": "@patchwork/tasks-next",
  "version": "0.1.0",
  "description": "Task queues, workers and routers: the experimental line of the task framework",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "vite build",
    "push": "pushwork sync",
    "watch": "nodemon --watch src -e js,tsx,ts,tsx,css,json --exec 'pnpm build && pnpm push'",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:node": "node scripts/build-node.mjs",
    "host": "node dist-node/host.mjs"
  },
  "keywords": [],
  "author": "Ink & Switch",
  "dependencies": {
    "@automerge/automerge": "^3.2.6",
    "@automerge/automerge-repo": "2.6.0-subduction.20",
    "@automerge/automerge-repo-node": "npm:@automerge/automerge-repo@2.6.0-subduction.43",
    "@automerge/automerge-repo-storage-indexeddb": "2.6.0-subduction.20",
    "@automerge/vanillajs": "2.6.0-subduction.20",
    "@inkandswitch/patchwork-bootloader": "^0.7.2",
    "@inkandswitch/patchwork-elements": "^6.0.2",
    "@inkandswitch/patchwork-plugins": "^1.2.5",
    "boring-name-generator": "^1.0.3",
    "es-module-shims": "^2.8.1",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.21.5",
    "happy-dom": "^15.11.7",
    "nodemon": "^3.1.14",
    "vite": "^5.4.21",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-solid": "^2.11.17",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.4"
  }
}
