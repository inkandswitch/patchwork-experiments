{
  "name": "@tiny-patchwork/implicit",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "Implicit Surface: write signed distance functions in a tiny safe language, see them raymarched live and exactly on the GPU, and mesh them into a Scene with surface nets.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@automerge/automerge-codemirror": "^0.2.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1"
  },
  "devDependencies": {
    "@automerge/automerge": "^3.2.1",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "happy-dom": "^15.11.7",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
