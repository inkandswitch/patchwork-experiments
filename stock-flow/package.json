{
  "name": "@patchwork/stock-flow",
  "version": "0.0.1",
  "description": "Stock and flow models with derived feedback loops, charts and scenario cards that embed in markdown, and a CLI for working on them with any LLM",
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "sf": "./cli/sf.ts"
  },
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "sf": "node cli/sf.ts",
    "export:aachen": "tsx examples/aachen/export.ts",
    "sync": "pnpm build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\""
  },
  "keywords": [],
  "author": "Ink & Switch",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@automerge/automerge": "3.3.0-fragments.2",
    "@automerge/automerge-repo": "2.6.0-subduction.43",
    "@automerge/automerge-repo-storage-lmdb": "2.6.0-subduction.43",
    "@automerge/automerge-subduction": "0.16.0",
    "@dagrejs/dagre": "^1.1.4",
    "@duckdb/node-api": "2.0.0-r.1",
    "@inkandswitch/patchwork-plugins": "^0.0.11"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.2.6",
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.0"
  }
}
