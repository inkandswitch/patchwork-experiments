{
  "name": "@tiny-patchwork/agent",
  "type": "module",
  "private": true,
  "main": "./index.js",
  "description": "An agentic harness that lives inside Patchwork: a session document, a leased runner, and tools that read and write automerge documents.",
  "scripts": {
    "sync": "pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "runner": "node node-runner.mjs"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@automerge/automerge": "3.3.0-fragments.2",
    "@automerge/automerge-repo": "2.6.0-subduction.43"
  }
}
