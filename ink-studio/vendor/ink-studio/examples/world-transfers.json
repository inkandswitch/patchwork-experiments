{
  "format":"ink-studio/world",
  "id":"transfer-station",
  "dt":1,
  "systems":{
    "basin":{"kind":"water","config":{
      "width":1,"height":1,"cell":1,
      "initial":[{"bounds":{"min":[0,0],"max":[1,1]},"value":8}],
      "accounts":{"outlet":[0.5,0.5]}
    }},
    "cistern":{"kind":"store","config":{"accounts":{
      "water":{"resource":"water","units":"world^3","initial":8,"max":10},
      "heat":{"resource":"thermal-energy","units":"J","initial":45,"max":50},
      "bolts":{"resource":"bolt","units":"item","type":"integer","initial":3,"max":4}
    }}},
    "workshop":{"kind":"store","config":{"accounts":{
      "heat":{"resource":"thermal-energy","units":"J","initial":20},
      "bolts":{"resource":"bolt","units":"item","type":"integer","initial":7}
    }}},
    "dock":{"kind":"store","config":{"accounts":{
      "cart":{"resource":"momentum","units":"kg*m/s","type":"vec3","initial":[5,1,0]},
      "brake":{"resource":"momentum","units":"kg*m/s","type":"vec3","initial":[0,0,0]}
    }}},
    "pipe":{"kind":"exchange","config":{"links":{
      "fill":{"from":"basin/outlet","to":"cistern/water","rate":5}
    }}}
  },
  "commands":[
    {"tick":1,"action":"world/transfer","args":{"id":"heat","from":"workshop/heat","to":"cistern/heat","amount":8}},
    {"tick":1,"action":"world/transfer","args":{"id":"bolts-full","from":"workshop/bolts","to":"cistern/bolts","amount":3,"mode":"exact"}},
    {"tick":1,"action":"world/transfer","args":{"id":"brake","from":"dock/cart","to":"dock/brake","amount":[2,-1,0]}},
    {"tick":2,"action":"world/transfer","args":{"id":"bolts-partial","from":"workshop/bolts","to":"cistern/bolts","amount":3}}
  ]
}
