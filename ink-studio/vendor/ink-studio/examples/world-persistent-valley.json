{
  "format": "ink-studio/world",
  "version": 1,
  "id": "persistent-valley",
  "dt": 0.05,
  "systems": {
    "props": {
      "kind": "mechanics",
      "config": {
        "continuous": true,
        "gravity": [0,0,0],
        "bodies": {
          "cart": { "position": [1.3,0.21,2], "velocity": [0.84,0,0], "half": [0.22,0.21,0.18], "look": [19,20,21,22,23] }
        }
      }
    },
    "ford": {
      "kind": "water",
      "config": {
        "width": 14, "height": 5, "cell": 0.5, "base": 0.43,
        "bed": [{ "bounds": { "min": [0,1], "max": [7,1.5] }, "value": 0 }],
        "initial": [{ "bounds": { "min": [0,1], "max": [7,1.5] }, "value": 0.39 }],
        "sediment": { "erodibleDepth": 0, "capacity": 0.01, "settling": 2.5,
          "initial": [{ "bounds": { "min": [2.75,1], "max": [4.25,1.5] }, "value": 0.4 }]
        }
      }
    },
    "meadow": {
      "kind": "logistics",
      "config": {
        "resources": { "biomass": { "units": "kg", "look": [7,8,9,10,11] } },
        "containers": {
          "reeds": { "position": [4.4,0.43,2], "stocks": {
            "biomass": { "initial": 0.05, "max": 1, "display": { "at": [4.4,0.43,2], "half": [0.21,0.62,0.19] } }
          } }
        },
        "recipes": { "grow": { "duration": 0.2, "outputs": { "biomass": 0.08 } } },
        "processes": { "reeds": { "recipe": "grow", "outputs": { "biomass": "reeds" } } }
      }
    },
    "lookout-props": {
      "kind": "mechanics",
      "config": {
        "gravity": [0,0,0],
        "bodies": {
          "sled": { "position": [66,0.15,2], "velocity": [0.34,0,0], "half": [0.26,0.15,0.2] }
        }
      }
    }
  },
  "simulationChunks": {
    "grid": { "dimensions": 2, "size": 8 },
    "hysteresis": 1,
    "levels": [
      { "id": "full", "within": 2, "every": 1, "systems": {
        "mechanics": { "substeps": 2, "tuning": { "contactIterations": 12 } },
        "water": { "tuning": { "cfl": 0.35, "maxDt": 0.028 } }
      } },
      { "id": "coarse", "within": 14, "every": 4, "systems": {
        "mechanics": { "tuning": { "contactIterations": 3 } },
        "water": { "tuning": { "cfl": 0.46, "maxDt": 0.095 } }
      } },
      { "id": "sleep", "sleep": true }
    ],
    "chunks": {
      "valley": { "index": [0,0], "systems": ["props","meadow","ford"], "wake": { "holdTicks": 2 } },
      "lookout": { "index": [8,0], "systems": ["lookout-props"] }
    },
    "focus": { "player": { "at": [3,0,2] } }
  },
  "commands": [
    { "tick": 9, "action": "world/chunk-focus", "args": { "id": "player", "at": [13,0,2] } },
    { "tick": 17, "action": "world/chunk-focus", "args": { "id": "player", "at": [66,0,2] } },
    { "tick": 34, "action": "world/chunk-focus", "args": { "id": "player", "at": [3,0,2] } }
  ],
  "visual": {
    "bounds": { "min": [0,-0.26,0], "max": [7,1.2,2.5] },
    "resolution": 0.09,
    "camera": { "target": [3.35,0.36,1.2], "dist": 10, "yaw": -0.18, "pitch": 0.62 },
    "fields": {
      "bed": "ford/bed",
      "water": "ford/water",
      "sediment": "ford/bed-change",
      "bodies": ["props/bodies","meadow/stock-bodies"]
    }
  }
}
