{
  "format": "ink-studio/world",
  "version": 1,
  "id": "puzzle-gate",
  "seed": 18,
  "dt": 0.1,
  "causality": true,
  "history": {"where": {"path": ["kind"], "value": "puzzle-output-changed"}},
  "systems": {
    "lock": {"kind": "puzzle", "config": {
      "inputs": {"plate": "bool", "prime": "event", "switch": "event", "reset": "event"},
      "nodes": {
        "gate-ready": {"op": "all", "inputs": ["plate", "timed-switch"]},
        "timed-switch": {"op": "window", "trigger": "ordered-switches", "ticks": 45, "reset": "reset"},
        "ordered-switches": {"op": "sequence", "steps": ["prime", "switch"], "reset": "reset"}
      },
      "outputs": {"open": "gate-ready"},
      "moves": {
        "stand-on-plate": {"set": {"plate": true}},
        "step-off-plate": {"set": {"plate": false}},
        "prime-switch": {"pulse": ["prime"]},
        "throw-switch": {"pulse": ["switch"], "when": {"signal": "plate"}},
        "reset-switches": {"pulse": ["reset"]}
      }
    }},
    "gate-drive": {"kind": "control", "config": {"op": "choose"}},
    "rig": {"kind": "mechanics", "config": {
      "bodies": {
        "court": {"fixed": true, "position": [0, 0, 0], "half": [2.8, 0.12, 1.55], "look": [1, 2, 3, 4]},
        "back-wall": {"fixed": true, "position": [0, 0.75, -1.12], "half": [0.17, 0.63, 0.55], "look": [2, 3, 4, 5]},
        "front-wall": {"fixed": true, "position": [0, 0.75, 1.12], "half": [0.17, 0.63, 0.55], "look": [2, 3, 4, 5]},
        "crossbar": {"fixed": true, "position": [0, 1.62, 0], "half": [0.24, 0.12, 1.68], "look": [3, 4, 5, 6]},
        "door": {"half": [0.09, 0.58, 0.58], "look": [12, 13, 14, 15, 16]},
        "plate": {"fixed": true, "position": [-1.8, 0.13, -0.56], "half": [0.32, 0.025, 0.29], "look": [17, 18, 19, 20]},
        "switch-base": {"fixed": true, "position": [-0.65, 0.36, -0.99], "half": [0.12, 0.24, 0.12], "look": [2, 3, 4, 5]},
        "switch-handle": {"fixed": true, "position": [-0.65, 0.66, -0.99], "half": [0.055, 0.11, 0.055], "look": [17, 18, 19, 20]}
      },
      "joints": {"door": {"kind": "slider", "child": "door", "mode": "position", "anchor": [0, 0.7, 0],
        "axis": [0, 1, 0], "range": [0, 1.31], "speed": 2.8}}
    }},
    "scout": {"kind": "agents", "config": {
      "bounds": {"min": [-2.23, 0.09, -0.98], "max": [2.24, 1.2, 0.98]},
      "clearance": "rig/clearance", "ground": 0.125, "cell": 0.19, "replanTicks": 3,
      "species": {"walker": {"mode": "walk", "radius": 0.23, "height": 0.54, "speed": 1.45, "look": [19, 20, 21, 22]}},
      "agents": {"scout": {"species": "walker", "position": [-1.35, 0.125, 0], "goal": [1.65, 0.125, 0]}}
    }}
  },
  "connections": [
    {"from": "lock/open", "to": "gate-drive/enabled"},
    {"from": "gate-drive/value", "to": "rig/drive.door"}
  ],
  "commands": [
    {"id": "drive-height", "tick": 1, "action": "world/input", "args": {"port": "gate-drive/b", "value": 1.31}}
  ],
  "scenario": {
    "allow": ["world/input"],
    "until": 60,
    "rules": [{"id": "scout-through-gate", "kind": "win", "field": "scout/agents",
      "when": {"path": ["scout", "position", 0], "op": "gt", "value": 1.25}}]
  },
  "visual": {
    "bounds": {"min": [-2.84, -0.27, -1.69], "max": [2.84, 2.72, 1.69]},
    "ground": -0.26,
    "resolution": 0.065,
    "camera": {"target": [0, 0.83, 0], "dist": 8.1, "yaw": 0.79, "pitch": 0.44},
    "fields": {"bodies": "rig/bodies", "agents": ["scout/agents"]}
  }
}
