{
  "format": "ink-studio/world",
  "version": 1,
  "id": "aggregate-estuary",
  "dt": 0.05,
  "systems": {
    "lagoon": {
      "kind": "water",
      "config": {
        "width": 24, "height": 16, "cell": 0.5, "base": 0,
        "bed": [{ "bounds": { "min": [5, 0], "max": [7, 1.5] }, "value": 0.17 }],
        "initial": [{ "bounds": { "min": [2, 0.5], "max": [7, 3.5] }, "value": 0.52 }],
        "sensors": { "shoal": [6, 2] }
      }
    },
    "flock": {
      "kind": "agents",
      "config": {
        "bounds": { "min": [0, -0.1, 3.8], "max": [12, 2.5, 8] },
        "species": {
          "shorebird": { "mode": "walk", "radius": 0.11, "speed": 0.8, "look": [4, 5, 6, 24] }
        },
        "agents": {
          "bird-1": { "species": "shorebird", "position": [3.0, 0, 5.5], "goal": [7.8, 0, 5.5] },
          "bird-2": { "species": "shorebird", "position": [3.3, 0, 5.7], "goal": [8.1, 0, 5.7] },
          "bird-3": { "species": "shorebird", "position": [3.7, 0, 6.0], "goal": [8.5, 0, 6.0] },
          "bird-4": { "species": "shorebird", "position": [4.0, 0, 5.5], "goal": [8.8, 0, 5.5] },
          "bird-5": { "species": "shorebird", "position": [4.2, 0, 5.9], "goal": [9.0, 0, 5.9] },
          "bird-6": { "species": "shorebird", "position": [4.4, 0, 6.3], "goal": [9.2, 0, 6.3] }
        }
      }
    },
    "mill": {
      "kind": "logistics",
      "config": {
        "resources": { "grain": { "units": "kg" }, "flour": { "units": "kg", "look": [19, 20, 21, 22] } },
        "containers": {
          "hopper": { "stocks": { "grain": { "initial": 8, "max": 12 }, "flour": { "initial": 0, "max": 8 } } },
          "silo": { "stocks": { "flour": { "initial": 0, "max": 12, "display": { "at": [6.6, 0, 4.8], "half": [0.26, 0.72, 0.26] } } } }
        },
        "recipes": { "grind": { "duration": 0.16, "inputs": { "grain": 0.36 }, "outputs": { "flour": 0.30 } } },
        "processes": { "grinder": { "recipe": "grind", "inputs": { "grain": "hopper" }, "outputs": { "flour": "hopper" } } },
        "links": { "belt": { "from": "hopper", "to": "silo", "resource": "flour", "rate": 1, "travel": 0.12 } }
      }
    }
  },
  "simulationChunks": {
    "grid": { "dimensions": 2, "size": 16 },
    "levels": [
      { "id": "near", "within": 1, "every": 1 },
      { "id": "distant", "within": 40, "every": 1, "systems": {
        "water": { "aggregate": { "model": "blocks", "factor": 4, "preserve": ["volume", "momentum"] } },
        "agents": { "aggregate": { "model": "cohorts", "cell": 16, "preserve": ["population", "species"] } },
        "logistics": { "aggregate": { "model": "ledger", "preserve": ["grain", "flour"] } }
      } },
      { "id": "sleep", "sleep": true }
    ],
    "chunks": { "estuary": { "index": [0, 0], "systems": ["lagoon", "flock", "mill"] } },
    "focus": { "player": { "at": [5, 0, 4] } }
  },
  "commands": [
    { "tick": 5, "action": "world/chunk-focus", "args": { "id": "player", "at": [29, 0, 4] } },
    { "tick": 18, "action": "world/chunk-focus", "args": { "id": "player", "at": [80, 0, 4] } },
    { "tick": 25, "action": "world/chunk-focus", "args": { "id": "player", "at": [5, 0, 4] } }
  ],
  "visual": {
    "bounds": { "min": [0, -0.24, 0], "max": [12, 1.4, 8] },
    "resolution": 0.14,
    "camera": { "target": [5.8, 0.2, 4], "dist": 16, "yaw": 0.32, "pitch": 0.64 },
    "fields": { "bed": "lagoon/bed", "water": "lagoon/water", "agents": ["flock/agents"], "bodies": ["mill/stock-bodies"] }
  }
}
