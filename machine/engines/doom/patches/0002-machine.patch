+// The hashes of the current state, as a trace record would hold them:
+// all, strict, mobj, player, sector, special, world, misc, order, links,
+// rnd, view. Writes nothing unless -trace or -hashonly is on, but does
+// stamp trace ids on mobjs, so a machine calls it on a copy.
+const uint64_t *TRACE_Hashes(void)
+{
+    WriteTic();
+    return last_hashes;
+}
