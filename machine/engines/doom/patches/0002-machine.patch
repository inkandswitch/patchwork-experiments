+// The device hears every sound, from wherever it starts and for whichever
+// player, before the listener's distance decides whether Doom mixes it.
+
+void S_StartSound(void *origin, int sfx_id)
+{
+    I_SoundEvent(origin, sfx_id);
+    StartSound(origin, sfx_id);
+}
+
+void S_StopSound(mobj_t *origin)
+{
+    I_StopSoundEvent(origin);
+    StopSound(origin);
+}
+
+// A sound only its player hears in vanilla, such as a pickup.
+
+void S_StartPlayerSound(player_t *player, int sfx_id)
+{
+    I_SoundEvent(player->mo, sfx_id);
+    if (player == &players[consoleplayer])
+    {
+        StartSound(NULL, sfx_id);
+    }
+}
