 }
 
-void S_StartSound(void *origin_p, int sfx_id)
+static void StartSound(void *origin_p, int sfx_id)
 {
     sfxinfo_t *sfx;
     mobj_t *origin;
@@ -503,7 +503,7 @@ void S_StartSound(void *origin_p, int sfx_id)
     pitch = Clamp(pitch);
 
     // kill old sound
-    S_StopSound(origin);
+    StopSound(origin);
 
     // try to find a channel
     cnum = S_GetChannel(origin, sfx);
@@ -528,6 +528,32 @@ void S_StartSound(void *origin_p, int sfx_id)
