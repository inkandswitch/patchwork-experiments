+
+extern void G_EndBotRecording(void);
+
+// The state before the first ticcmd (demo playback, level just loaded).
+void TRACE_LevelStart(void)
+{
+    if (trace_fp || hash_fp)
+        WriteTic();
+    if (save_every && gamestate == GS_LEVEL)
+        SaveNow();
+}
+
+void TRACE_EndTic(void)
+{
+    trace_demotic++;
+    if (simlog_fp)
+        fprintf(simlog_fp, "%d %llu\n", trace_demotic, (unsigned long long) sim_ns);
+    if (trace_fp || hash_fp)
+        WriteTic();
+    sim_ns = 0;
+    if (save_every && gamestate == GS_LEVEL
+        && trace_demotic % save_every == 0)
+        SaveNow();
+    if (trace_bot && trace_demotic >= bot_tics)
+        G_EndBotRecording();
+}
+
+static void Shutdown(void)
+{
+    if (trace_fp)
+    {
+        if (trace_piped) pclose(trace_fp); else fclose(trace_fp);
+        trace_fp = NULL;
+    }
+    if (hash_fp) { fclose(hash_fp); hash_fp = NULL; }
+    if (simlog_fp) { fclose(simlog_fp); simlog_fp = NULL; }
+    if (savelog_fp) { fclose(savelog_fp); savelog_fp = NULL; }
+    fprintf(stderr, "TRACE: %d tics simulated, P_Ticker total %.3f ms, "
+            "mean %.2f us/tic\n", sim_count, sim_total_ns / 1e6,
+            sim_count ? sim_total_ns / 1e3 / sim_count : 0.0);
+}
+
+void TRACE_Init(void)
+{
+    int p;
+    char path[600];
+
+    if ((p = M_CheckParmWithArgs("-trace", 1)))
+    {
+        const char *t = myargv[p + 1];
+        if (M_StringEndsWith(t, ".gz"))
+        {
+            M_snprintf(path, sizeof(path), "gzip -1 > '%s'", t);
+            trace_fp = popen(path, "w");
+            trace_piped = true;
+        }
+        else
+            trace_fp = M_fopen(t, "wb");
+        if (!trace_fp) I_Error("TRACE: cannot open %s", t);
+        M_snprintf(path, sizeof(path), "%s.hash", t);
+        hash_fp = M_fopen(path, "w");
+    }
+    if ((p = M_CheckParmWithArgs("-hashonly", 1)))
+        hash_fp = M_fopen(myargv[p + 1], "w");
+    if ((p = M_CheckParmWithArgs("-simlog", 1)))
+        simlog_fp = M_fopen(myargv[p + 1], "w");
+    if ((p = M_CheckParmWithArgs("-saveevery", 1)))
+        save_every = atoi(myargv[p + 1]);
+    if ((p = M_CheckParmWithArgs("-savedir", 1)))
+    {
+        save_dir = myargv[p + 1];
+        M_snprintf(path, sizeof(path), "%s/saves.log", save_dir);
+        if (save_every) savelog_fp = M_fopen(path, "w");
+    }
+    if (save_every && !save_dir) I_Error("TRACE: -saveevery needs -savedir");
+    if ((p = M_CheckParmWithArgs("-bottics", 1)))
+        bot_tics = atoi(myargv[p + 1]);
+    if ((p = M_CheckParmWithArgs("-botseed", 1)))
+        bot_seed = (unsigned) atoi(myargv[p + 1]);
+    if ((p = M_CheckParmWithArgs("-join", 2)))
+    {
+        join_path = myargv[p + 1];
+        join_tic = atoi(myargv[p + 2]);
+    }
+    if ((p = M_CheckParmWithArgs("-joinfix", 1)))
+        join_mask = atoi(myargv[p + 1]);
+    I_AtExit(Shutdown, true);
+}
