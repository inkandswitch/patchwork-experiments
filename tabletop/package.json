{
  "name": "@tiny-patchwork/tabletop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "Board games as documents: a game says what its pieces look like, how many there are and where they start; setting up a table lays them out in a 3D scene to play with the scene's hand.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "@inkandswitch/patchwork-plugins": "^0.0.11",
    "happy-dom": "^15.11.7",
    "three": "^0.186.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
