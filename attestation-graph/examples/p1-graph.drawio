4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" value="&lt;div&gt;&lt;b&gt;Assumption&lt;/b&gt;&lt;/div&gt;item on build plate&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;at end of print&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;is correctly delivered&lt;/span&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1000" y="470" width="190" height="100" as="geometry" /></mxCell><mxCell id="top_in7_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;13&lt;/sub&gt;" vertex="1"><mxGeometry x="1070" y="446" width="50" height="24" as="geometry" /></mxCell><mxCell id="top_gF" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=13;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="573" y="500" width="84" height="40" as="geometry" /></mxCell><mxCell id="top_f0" edge="1" parent="1" source="top_o" target="top_gF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="top_f6" edge="1" parent="1" source="top_in6" target="top_gF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="top_f7" edge="1" parent="1" source="top_in7" target="top_gF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="top_E" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=13;" value="&lt;b&gt;E: correct print delivered&lt;/b&gt;&lt;br&gt;agreed file F executed to completion and delivered" vertex="1"><mxGeometry x="415" y="620" width="400" height="56" as="geometry" /></mxCell><mxCell id="top_fE" edge="1" parent="1" source="top_gF" target="top_E" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="top_f" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=8;fontSize=12;strokeColor=#808080;align=left;spacingLeft=8;" value="E = (([in&lt;sub&gt;1&lt;/sub&gt;–in&lt;sub&gt;8&lt;/sub&gt;] ∧ in&lt;sub&gt;9&lt;/sub&gt;) ∨ [in&lt;sub&gt;2&lt;/sub&gt;, in&lt;sub&gt;3&lt;/sub&gt;, in&lt;sub&gt;5&lt;/sub&gt;–in&lt;sub&gt;8&lt;/sub&gt;, in&lt;sub&gt;10&lt;/sub&gt;, in&lt;sub&gt;11&lt;/sub&gt;] ∨ (in&lt;sub&gt;6&lt;/sub&gt; ∧ in&lt;sub&gt;8&lt;/sub&gt;)) ∧ in&lt;sub&gt;12&lt;/sub&gt; ∧ in&lt;sub&gt;13&lt;/sub&gt;" vertex="1"><mxGeometry x="860" y="624" width="440" height="48" as="geometry" /></mxCell><mxCell id="top_n" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=8;fontSize=10;strokeColor=#808080;align=left;spacingLeft=6;spacingRight=6;" value="The source of evidence is chosen once: the print witness ([in&lt;sub&gt;1&lt;/sub&gt;–in&lt;sub&gt;8&lt;/sub&gt;], which needs the physical setup assumption in&lt;sub&gt;9&lt;/sub&gt;), zkTLS ([in&lt;sub&gt;2&lt;/sub&gt;, in&lt;sub&gt;3&lt;/sub&gt;, in&lt;sub&gt;5&lt;/sub&gt;–in&lt;sub&gt;8&lt;/sub&gt;, in&lt;sub&gt;10&lt;/sub&gt;, in&lt;sub&gt;11&lt;/sub&gt;]), or no attestation at all (in&lt;sub&gt;8&lt;/sub&gt; ∧ in&lt;sub&gt;6&lt;/sub&gt;). Records from the two sources cannot be mixed. Within a source, either claim can still be replaced by its assumption; see the next two pages. A bracketed list above a node marks a zoomed node: it stands for the sub-graph of the combined graph over those inputs, shown on its zoom page." vertex="1"><mxGeometry x="40" y="720" width="520" height="80" as="geometry" /></mxCell><mxCell id="top_lg0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" value="&lt;b&gt;Assumption or verifier parameter&lt;/b&gt;&lt;br&gt;trusted input" vertex="1"><mxGeometry x="620.0" y="720.0" width="150" height="48" as="geometry" /></mxCell><mxCell id="top_lg1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" value="&lt;b&gt;Attestation&lt;/b&gt;&lt;br&gt;untrusted until verified" vertex="1"><mxGeometry x="790.0" y="720.0" width="150" height="48" as="geometry" /></mxCell><mxCell id="top_lg2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="620.0" y="786.0" width="60" height="30" as="geometry" /></mxCell><mxCell id="top_lg3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" value="all inputs must hold" vertex="1"><mxGeometry x="686.0" y="786.0" width="120" height="30" as="geometry" /></mxCell><mxCell id="top_lg4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;strokeWidth=1.5;" value="OR" vertex="1"><mxGeometry x="790.0" y="782.0" width="60" height="38" as="geometry" /></mxCell><mxCell id="top_lg5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" value="any input suffices" vertex="1"><mxGeometry x="856.0" y="786.0" width="120" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="pW" name="Zoom: print witness path"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0"