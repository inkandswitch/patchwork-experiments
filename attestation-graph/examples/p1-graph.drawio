ry" /></mxCell><mxCell id="chosen_in7_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;13&lt;/sub&gt;" vertex="1"><mxGeometry x="1060" y="626" width="50" height="24" as="geometry" /></mxCell><mxCell id="chosen_G" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=13;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="568" y="680" width="84" height="40" as="geometry" /></mxCell><mxCell id="chosen_g0" edge="1" parent="1" source="chosen_W" target="chosen_G" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="chosen_g6" edge="1" parent="1" source="chosen_in6" target="chosen_G" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="chosen_g7" edge="1" parent="1" source="chosen_in7" target="chosen_G" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="chosen_lW" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" value="print witness evidence counts only if the physical setup is correct and unchanged" vertex="1"><mxGeometry x="660" y="544" width="320" height="40" as="geometry" /></mxCell><mxCell id="chosen_lG" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" value="and the printer operates as described and the item is delivered" vertex="1"><mxGeometry x="660" y="724" width="320" height="30" as="geometry" /></mxCell><mxCell id="chosen_E" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=13;" value="&lt;b&gt;E: correct print delivered&lt;/b&gt;&lt;br&gt;agreed file F executed to completion and delivered" vertex="1"><mxGeometry x="410" y="790" width="400" height="56" as="geometry" /></mxCell><mxCell id="chosen_gE" edge="1" parent="1" source="chosen_G" target="chosen_E" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="chosen_fm" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=8;fontSize=12;strokeColor=#808080;align=left;spacingLeft=8;" value="E = in&lt;sub&gt;1&lt;/sub&gt; ∧ in&lt;sub&gt;2&lt;/sub&gt; ∧ in&lt;sub&gt;3&lt;/sub&gt; ∧ in&lt;sub&gt;4&lt;/sub&gt; ∧ in&lt;sub&gt;5&lt;/sub&gt; ∧ in&lt;sub&gt;7&lt;/sub&gt; ∧ in&lt;sub&gt;9&lt;/sub&gt; ∧ in&lt;sub&gt;12&lt;/sub&gt; ∧ in&lt;sub&gt;13&lt;/sub&gt;" vertex="1"><mxGeometry x="850" y="794" width="400" height="48" as="geometry" /></mxCell><mxCell id="chosen_n" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=8;fontSize=10;strokeColor=#808080;align=left;spacingLeft=6;spacingRight=6;" value="Chosen path: both the job file and the logs are attested via the print witness, so the match checker (in&lt;sub&gt;7&lt;/sub&gt;) is needed and the physical setup assumption (in&lt;sub&gt;9&lt;/sub&gt;) applies. The zkTLS branch ([in&lt;sub&gt;2&lt;/sub&gt;, in&lt;sub&gt;3&lt;/sub&gt;, in&lt;sub&gt;5&lt;/sub&gt;–in&lt;sub&gt;8&lt;/sub&gt;, in&lt;sub&gt;10&lt;/sub&gt;, in&lt;sub&gt;11&lt;/sub&gt;]) and the assumptions in&lt;sub&gt;8&lt;/sub&gt; and in&lt;sub&gt;6&lt;/sub&gt; are removed, along with every OR; all remaining inputs must hold." vertex="1"><mxGeometry x="