<mxfile host="app.diagrams.net"><diagram id="mpc" name="MPC-TLS with a Verifier"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2060" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mpc_in1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="&lt;b&gt;Attestation&lt;/b&gt;&lt;br&gt;server certificate chain and signature over the key exchange (from the MPC-TLS handshake)" vertex="1"><mxGeometry x="40.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in1_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;1&lt;/sub&gt;" vertex="1"><mxGeometry x="95.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_in2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Verifier parameter&lt;/b&gt;&lt;br&gt;trusted root CA store (Web PKI)" vertex="1"><mxGeometry x="220.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in2_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;2&lt;/sub&gt;" vertex="1"><mxGeometry x="275.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_in3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Verifier parameter&lt;/b&gt;&lt;br&gt;expected server name (domain)" vertex="1"><mxGeometry x="400.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in3_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;3&lt;/sub&gt;" vertex="1"><mxGeometry x="455.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_in4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Assumption&lt;/b&gt;&lt;br&gt;the CAs and the server’s private key are not compromised" vertex="1"><mxGeometry x="580.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in4_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;4&lt;/sub&gt;" vertex="1"><mxGeometry x="635.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_g1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=13;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="328.0" y="240" width="124" height="40" as="geometry"/></mxCell><mxCell id="mpc_g1_a" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" value="establishes: the session was with the named server" vertex="1"><mxGeometry x="456.0" y="274" width="200" height="44" as="geometry"/></mxCell><mxCell id="mpc_eg1_0" edge="1" parent="1" source="mpc_in1" target="mpc_g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120.0" y="228"/><mxPoint x="352.8" y="228"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg1_1" edge="1" parent="1" source="mpc_in2" target="mpc_g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300.0" y="218"/><mxPoint x="377.6" y="218"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg1_2" edge="1" parent="1" source="mpc_in3" target="mpc_g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480.0" y="218"/><mxPoint x="402.4" y="218"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg1_3" edge="1" parent="1" source="mpc_in4" target="mpc_g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660.0" y="228"/><mxPoint x="427.2" y="228"/></Array></mxGeometry></mxCell><mxCell id="mpc_in5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="&lt;b&gt;Attestation&lt;/b&gt;&lt;br&gt;Verifier’s MPC-TLS session record (its key share, encrypted transcript, handshake hash)" vertex="1"><mxGeometry x="760.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in5_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;5&lt;/sub&gt;" vertex="1"><mxGeometry x="815.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_in6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Assumption&lt;/b&gt;&lt;br&gt;the relying party runs the Verifier itself" vertex="1"><mxGeometry x="940.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in6_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;6&lt;/sub&gt;" vertex="1"><mxGeometry x="995.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_in7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Assumption&lt;/b&gt;&lt;br&gt;the third-party Verifier does not collude with the Prover" vertex="1"><mxGeometry x="1120.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in7_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;7&lt;/sub&gt;" vertex="1"><mxGeometry x="1175.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_g2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=13;strokeWidth=1.5;" value="OR" vertex="1"><mxGeometry x="1062.0" y="240" width="96" height="56" as="geometry"/></mxCell><mxCell id="mpc_g2_a" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" value="establishes: the Verifier’s own view can be relied on" vertex="1"><mxGeometry x="1162.0" y="290" width="200" height="44" as="geometry"/></mxCell><mxCell id="mpc_eg2_0" edge="1" parent="1" source="mpc_in6" target="mpc_g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3333;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020.0" y="228"/><mxPoint x="1094.0" y="228"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg2_1" edge="1" parent="1" source="mpc_in7" target="mpc_g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6667;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200.0" y="228"/><mxPoint x="1126.0" y="228"/></Array></mxGeometry></mxCell><mxCell id="mpc_g3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=13;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="933.0" y="370" width="84" height="40" as="geometry"/></mxCell><mxCell id="mpc_g3_a" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" value="establishes: the transcript comes from a TLS session the Verifier helped run" vertex="1"><mxGeometry x="1021.0" y="404" width="200" height="44" as="geometry"/></mxCell><mxCell id="mpc_eg3_0" edge="1" parent="1" source="mpc_in5" target="mpc_g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3333;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840.0" y="358"/><mxPoint x="961.0" y="358"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg3_1" edge="1" parent="1" source="mpc_g2" target="mpc_g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6667;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110.0" y="358"/><mxPoint x="989.0" y="358"/></Array></mxGeometry></mxCell><mxCell id="mpc_in8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="&lt;b&gt;Attestation&lt;/b&gt;&lt;br&gt;Prover’s presentation: selectively disclosed transcript (openings of the commitments)" vertex="1"><mxGeometry x="1300.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in8_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;8&lt;/sub&gt;" vertex="1"><mxGeometry x="1355.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_in9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Algorithm&lt;/b&gt;&lt;br&gt;TLSNotary verifier: checks proofs, commitment openings and the certificate" vertex="1"><mxGeometry x="1480.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in9_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;9&lt;/sub&gt;" vertex="1"><mxGeometry x="1535.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_g4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=13;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="1428.0" y="240" width="84" height="40" as="geometry"/></mxCell><mxCell id="mpc_g4_a" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" value="establishes: disclosed data matches the authenticated transcript" vertex="1"><mxGeometry x="1516.0" y="274" width="200" height="44" as="geometry"/></mxCell><mxCell id="mpc_eg4_0" edge="1" parent="1" source="mpc_in8" target="mpc_g4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3333;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380.0" y="228"/><mxPoint x="1456.0" y="228"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg4_1" edge="1" parent="1" source="mpc_in9" target="mpc_g4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6667;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560.0" y="228"/><mxPoint x="1484.0" y="228"/></Array></mxGeometry></mxCell><mxCell id="mpc_in10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Assumption&lt;/b&gt;&lt;br&gt;the cryptography is sound (TLS 1.2, MPC / ZK proofs, commitments, signatures)" vertex="1"><mxGeometry x="1660.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in10_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;10&lt;/sub&gt;" vertex="1"><mxGeometry x="1715.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_in11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Assumption&lt;/b&gt;&lt;br&gt;the server returns correct data (trust in the data source)" vertex="1"><mxGeometry x="1840.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="mpc_in11_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;11&lt;/sub&gt;" vertex="1"><mxGeometry x="1895.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="mpc_g5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=13;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="1224.0" y="500" width="150" height="40" as="geometry"/></mxCell><mxCell id="mpc_eg5_0" edge="1" parent="1" source="mpc_g1" target="mpc_g5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1667;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="488"/><mxPoint x="1249.0" y="488"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg5_1" edge="1" parent="1" source="mpc_g3" target="mpc_g5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3333;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975.0" y="478"/><mxPoint x="1274.0" y="478"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg5_2" edge="1" parent="1" source="mpc_g4" target="mpc_g5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470.0" y="468"/><mxPoint x="1299.0" y="468"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg5_3" edge="1" parent="1" source="mpc_in10" target="mpc_g5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6667;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1740.0" y="478"/><mxPoint x="1324.0" y="478"/></Array></mxGeometry></mxCell><mxCell id="mpc_eg5_4" edge="1" parent="1" source="mpc_in11" target="mpc_g5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8333;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1920.0" y="488"/><mxPoint x="1349.0" y="488"/></Array></mxGeometry></mxCell><mxCell id="mpc_E" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=13;" value="&lt;b&gt;E: the disclosed data is authentic: it was sent by the named server in a real TLS session&lt;/b&gt;" vertex="1"><mxGeometry x="1079.0" y="610" width="440" height="60" as="geometry"/></mxCell><mxCell id="mpc_eE" edge="1" parent="1" source="mpc_g5" target="mpc_E" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mpc_f" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=8;fontSize=12;strokeColor=#808080;align=left;spacingLeft=8;" value="E = (in&lt;sub&gt;1&lt;/sub&gt; ∧ in&lt;sub&gt;2&lt;/sub&gt; ∧ in&lt;sub&gt;3&lt;/sub&gt; ∧ in&lt;sub&gt;4&lt;/sub&gt;) ∧ (in&lt;sub&gt;5&lt;/sub&gt; ∧ (in&lt;sub&gt;6&lt;/sub&gt; ∨ in&lt;sub&gt;7&lt;/sub&gt;)) ∧ (in&lt;sub&gt;8&lt;/sub&gt; ∧ in&lt;sub&gt;9&lt;/sub&gt;) ∧ in&lt;sub&gt;10&lt;/sub&gt; ∧ in&lt;sub&gt;11&lt;/sub&gt;" vertex="1"><mxGeometry x="1539.0" y="610" width="501.0" height="60" as="geometry"/></mxCell><mxCell id="mpc_n" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=8;fontSize=10;strokeColor=#808080;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" value="&lt;b&gt;MPC-TLS with a Verifier (default).&lt;/b&gt; The Prover and Verifier run the TLS connection to the server together in MPC; neither learns the full session key, and the Verifier never sees the plaintext. The Prover then selectively discloses parts of the transcript.&lt;br&gt;&lt;b&gt;Trusted:&lt;/b&gt; root CA store, expected server name, the verifier algorithm, and the assumptions (Web PKI, cryptography, data source, who runs the Verifier).&lt;br&gt;&lt;b&gt;Untrusted until verified:&lt;/b&gt; the server certificate and signature, the Verifier’s session record (unless the relying party is the Verifier), and the Prover’s presentation.&lt;br&gt;If the relying party is not the Verifier, a third-party Verifier must not collude with the Prover; that is the Notary mode on the next page." vertex="1"><mxGeometry x="40" y="710" width="620" height="130" as="geometry"/></mxCell><mxCell id="mpc_lg0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" value="&lt;b&gt;Assumption or verifier parameter&lt;/b&gt;&lt;br&gt;trusted input" vertex="1"><mxGeometry x="700.0" y="710.0" width="150" height="48" as="geometry"/></mxCell><mxCell id="mpc_lg1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" value="&lt;b&gt;Attestation&lt;/b&gt;&lt;br&gt;untrusted until verified" vertex="1"><mxGeometry x="870.0" y="710.0" width="150" height="48" as="geometry"/></mxCell><mxCell id="mpc_lg2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="700.0" y="776.0" width="60" height="30" as="geometry"/></mxCell><mxCell id="mpc_lg3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" value="all inputs must hold" vertex="1"><mxGeometry x="766.0" y="776.0" width="120" height="30" as="geometry"/></mxCell><mxCell id="mpc_lg4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;strokeWidth=1.5;" value="OR" vertex="1"><mxGeometry x="870.0" y="772.0" width="60" height="38" as="geometry"/></mxCell><mxCell id="mpc_lg5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" value="any input suffices" vertex="1"><mxGeometry x="936.0" y="776.0" width="120" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="notary" name="General-purpose Notary"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2600" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notary_in1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="&lt;b&gt;Attestation&lt;/b&gt;&lt;br&gt;server certificate chain and signature over the key exchange (in the Prover’s presentation, committed to in the attestation)" vertex="1"><mxGeometry x="40.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="notary_in1_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;1&lt;/sub&gt;" vertex="1"><mxGeometry x="95.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="notary_in2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Verifier parameter&lt;/b&gt;&lt;br&gt;trusted root CA store (Web PKI)" vertex="1"><mxGeometry x="220.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="notary_in2_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;2&lt;/sub&gt;" vertex="1"><mxGeometry x="275.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="notary_in3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Verifier parameter&lt;/b&gt;&lt;br&gt;expected server name (domain)" vertex="1"><mxGeometry x="400.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="notary_in3_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;3&lt;/sub&gt;" vertex="1"><mxGeometry x="455.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="notary_in4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Assumption&lt;/b&gt;&lt;br&gt;the CAs and the server’s private key are not compromised" vertex="1"><mxGeometry x="580.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="notary_in4_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;4&lt;/sub&gt;" vertex="1"><mxGeometry x="635.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="notary_g1" p