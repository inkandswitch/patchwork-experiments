y="478"/></Array></mxGeometry></mxCell><mxCell id="notary_eg6_4" edge="1" parent="1" source="notary_in14" target="notary_g6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8333;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2460.0" y="488"/><mxPoint x="1736.0" y="488"/></Array></mxGeometry></mxCell><mxCell id="notary_E" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=13;" value="&lt;b&gt;E: the disclosed data is authentic: it was sent by the named server in a real TLS session&lt;/b&gt;" vertex="1"><mxGeometry x="1466.0" y="610" width="440" height="60" as="geometry"/></mxCell><mxCell id="notary_eE" edge="1" parent="1" source="notary_g6" target="notary_E" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notary_f" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=8;fontSize=12;strokeColor=#808080;align=left;spacingLeft=8;" value="E = (in&lt;sub&gt;1&lt;/sub&gt; ∧ in&lt;sub&gt;2&lt;/sub&gt; ∧ in&lt;sub&gt;3&lt;/sub&gt; ∧ in&lt;sub&gt;4&lt;/sub&gt;) ∧ ((in&lt;sub&gt;5&lt;/sub&gt; ∧ in&lt;sub&gt;6&lt;/sub&gt; ∧ in&lt;sub&gt;7&lt;/sub&gt;) ∨ (in&lt;sub&gt;8&lt;/sub&gt; ∧ in&lt;sub&gt;9&lt;/sub&gt; ∧ in&lt;sub&gt;10&lt;/sub&gt;)) ∧ (in&lt;sub&gt;11&lt;/sub&gt; ∧ in&lt;sub&gt;12&lt;/sub&gt;) ∧ in&lt;sub&gt;13&lt;/sub&gt; ∧ in&lt;sub&gt;14&lt;/sub&gt;" vertex="1"><mxGeometry x="1926.0" y="610" width="654.0" height="60" as="geometry"/></mxCell><mxCell id="notary_n" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=8;fontSize=10;strokeColor=#808080;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" value="&lt;b&gt;General-purpose Notary (attestations).&lt;/b&gt; The Notary runs the MPC-TLS verification and signs commitments to the transcript and to the server identity data, without seeing either. The Prover keeps the attestation and later shows any Verifier a presentation that opens the commitments it chooses.&lt;br&gt;&lt;b&gt;Trusted:&lt;/b&gt; Notary public key(s), root CA store, expected server name, the verifier algorithm, and the assumptions (Notary not colluding, Web PKI, cryptography, data source).&lt;br&gt;&lt;b&gt;Untrusted until verified:&lt;/b&gt; the signed attestation(s), the server certificate and signature, and the Prover’s presentation.&lt;br&gt;Requiring several Notaries reduces the risk of a Prover colluding with one Notary." vertex="1"><mxGeometry x="40" y="710" width="620" height="130" as="geometry"/></mxCell><mxCell id="notary_lg0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=10;" value="&lt;b&gt;Assumption or verifier parameter&lt;/b&gt;&lt;br&gt;trusted input" vertex="1"><mxGeometry x="700.0" y="710.0" width="150" height="48" as="geometry"/></mxCell><mxCell id="notary_lg1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" value="&lt;b&gt;Attestation&lt;/b&gt;&lt;br&gt;untrusted until verified" vertex="1"><mxGeometry x="870.0" y="710.0" width="150" height="48" as="geometry"/></mxCell><mxCell id="notary_lg2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;strokeWidth=1.5;" value="AND" vertex="1"><mxGeometry x="700.0" y="776.0" width="60" height="30" as="geometry"/></mxCell><mxCell id="notary_lg3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" value="all inputs must hold" vertex="1"><mxGeometry x="766.0" y="776.0" width="120" height="30" as="geometry"/></mxCell><mxCell id="notary_lg4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;strokeWidth=1.5;" value="OR" vertex="1"><mxGeometry x="870.0" y="772.0" width="60" height="38" as="geometry"/></mxCell><mxCell id="notary_lg5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" value="any input suffices" vertex="1"><mxGeometry x="936.0" y="776.0" width="120" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="proxy" name="Proxy mode"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2420" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="proxy_in1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="&lt;b&gt;Attestation&lt;/b&gt;&lt;br&gt;server certificate chain and signature over the key exchange (seen on the wire by the Verifier)" vertex="1"><mxGeometry x="40.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="proxy_in1_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;1&lt;/sub&gt;" vertex="1"><mxGeometry x="95.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="proxy_in2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Verifier parameter&lt;/b&gt;&lt;br&gt;trusted root CA store (Web PKI)" vertex="1"><mxGeometry x="220.0" y="90" width="160" height="90" as="geometry"/></mxCell><mxCell id="proxy_in2_l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;" value="in&lt;sub&gt;2&lt;/sub&gt;" vertex="1"><mxGeometry x="275.0" y="66" width="50" height="24" as="geometry"/></mxCell><mxCell id="proxy_in3" parent="1" style="rounded=1;whiteSpace=wrap;