{
  "name": "@tiny-patchwork/walk",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "The walk body for scenes: first person on whatever the rays hit, from the eye or a spawn point, riding what you stand on. Built only from scene extensions.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:all": "vitest run && vitest run --config vitest.slow.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "happy-dom": "^15.11.7",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
