	-rm -f ./$(DEPDIR)/aes_prng.Po
	-rm -f ./$(DEPDIR)/d_event.Po
	-rm -f ./$(DEPDIR)/d_iwad.Po
	-rm -f ./$(DEPDIR)/d_loop.Po
