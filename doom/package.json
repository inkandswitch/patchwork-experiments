{
  "name": "@tiny-patchwork/doom",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "Doom-format maps (.wad files) in a scene: a map is one static object and one object per door, every one built from the same WAD file document.",
  "scripts": {
    "dev": "vite build --watch",
