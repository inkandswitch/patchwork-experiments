    "sync": "vite build && pushwork sync",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "earcut": "3.0.1"
  },
  "devDependencies": {
    "@automerge/automerge": "3.3.0-fragments.2",
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "happy-dom": "^15.11.7",
    "three": "^0.186.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
