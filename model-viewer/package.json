{
  "name": "model-viewer",
  "version": "0.2.1",
  "description": "View 3D files (glb, gltf, stl, 3mf, 3dm, obj, ply) in Patchwork, and use Rhino .3dm files in scenes.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "rhino3dm": "8.35.0",
    "three": "0.180.0"
  }
}
