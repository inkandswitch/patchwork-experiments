{
  "name": "@tiny-patchwork/tts-import",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "Import a Tabletop Simulator mod's game assets (models, card sheets, tiles, tokens, boards, dice) into Patchwork documents and lay its starting table out as a 3D scene. No Lua.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "@inkandswitch/patchwork-plugins": "^0.0.11",
    "happy-dom": "^15.11.7",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
