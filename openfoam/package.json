{
  "name": "@tiny-patchwork/openfoam",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "description": "A frontend to OpenFOAM: describe a resistance analysis of a hull from a scene (double body or free surface), run it on an OpenFOAM daemon anywhere, watch it converge, and render the results into the scene.",
  "bin": {
    "foamd": "./daemon/foamd.mjs"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "sync": "vite build && pushwork sync",
    "daemon": "node daemon/foamd.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@automerge/automerge": "3.3.0-fragments.2",
    "@automerge/automerge-repo": "2.6.0-subduction.43",
    "@automerge/automerge-repo-storage-nodefs": "2.6.0-subduction.43"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.3.2",
    "happy-dom": "^15.11.7",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
